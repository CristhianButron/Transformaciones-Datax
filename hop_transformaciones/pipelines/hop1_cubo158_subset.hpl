<?xml version="1.0" encoding="UTF-8"?>
<!--
  [HOP-1] Prueba HOP-1 del informe Hito 2. Subconjunto representativo del
  cubo 158 (S_BOAPS_44_000620): 2 de las 18 tablas fuente reales
  (Producción y Siniestros de La Paz), con T1, T3, T4, T8 y T9. Ver
  hop_transformaciones/README.md para el detalle de qué se probó, cómo se
  ejecutó (hop-run, sin la GUI) y las diferencias frente a dbt/SQLMesh.
-->
<pipeline>
  <info>
    <name>hop1_cubo158_subset</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>[HOP-1] Subconjunto del cubo 158: union (T3) + clasificacion (T1) + normalizacion de texto (T8) + catalogo de compania (T9) + conversion de moneda (T4)</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/17 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/17 00:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>HOP-1: subconjunto de cubo 158 (La Paz, Produccion + Siniestros).&#10;T3 union -&gt; T1 clasificar tipo + T4 moneda -&gt; T8 texto -&gt; T9 catalogo -&gt; salida</note>
      <xloc>32</xloc>
      <yloc>16</yloc>
      <width>420</width>
      <heigth>40</heigth>
      <fontname>Noto Sans</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorblue>224</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Produccion La Paz</from>
      <to>Union (T3)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Siniestros La Paz</from>
      <to>Union (T3)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Union (T3)</from>
      <to>Clasificar y convertir (T1+T4)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Clasificar y convertir (T1+T4)</from>
      <to>Normalizar texto (T8)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Normalizar texto (T8)</from>
      <to>Renombrar campos</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Renombrar campos</from>
      <to>Catalogo de compania (T9)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Catalogo de compania (T9)</from>
      <to>Salida hop1_resultado_158_subset</to>
      <enabled>Y</enabled>
    </hop>
  </order>

  <transform>
    <name>Produccion La Paz</name>
    <type>TableInput</type>
    <description>Tabla real 01 del cubo 158 (Produccion, La Paz)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>aps_db</connection>
    <sql>select titulo1, titulo3, modalidad, ramo, nv1, nv2, fecha, valor from public.data_d_bo_000000447_01</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>32</xloc>
      <yloc>96</yloc>
    </GUI>
  </transform>

  <transform>
    <name>Siniestros La Paz</name>
    <type>TableInput</type>
    <description>Tabla real 10 del cubo 158 (Siniestros, La Paz)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>aps_db</connection>
    <sql>select titulo1, titulo3, modalidad, ramo, nv1, nv2, fecha, valor from public.data_d_bo_000000447_10</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>32</xloc>
      <yloc>224</yloc>
    </GUI>
  </transform>

  <transform>
    <name>Union (T3)</name>
    <type>Append</type>
    <description>T3: concatenacion de las dos tablas fuente (equivalente a t3_union_fuentes en dbt)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <head_name>Produccion La Paz</head_name>
    <tail_name>Siniestros La Paz</tail_name>
    <attributes/>
    <GUI>
      <xloc>224</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>

  <transform>
    <name>Clasificar y convertir (T1+T4)</name>
    <type>Formula</type>
    <description>T1: titulo1 -&gt; tipo (Produccion/Siniestros) por patron. T4: conversion de moneda, Bs = USD x 6.86</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formulas>
      <formula>
        <field_name>tipo</field_name>
        <formula>IF(ISNUMBER(SEARCH("Producci",[titulo1])),"Produccion","Siniestros")</formula>
        <replace_field/>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <value_type>2</value_type>
      </formula>
      <formula>
        <field_name>valor_bs</field_name>
        <formula>ROUND([valor]*6.86,2)</formula>
        <replace_field/>
        <value_length>-1</value_length>
        <value_precision>2</value_precision>
        <value_type>1</value_type>
      </formula>
    </formulas>
    <attributes/>
    <GUI>
      <xloc>352</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>

  <transform>
    <name>Normalizar texto (T8)</name>
    <type>StringOperations</type>
    <description>T8: trim del codigo de compania (nv2) y Title Case del departamento (titulo3), ej. "la PAZ" -&gt; "La Paz"</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <in_stream_name>nv2</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>titulo3</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>lower</lower_upper>
        <padding_type>none</padding_type>
        <pad_char/>
        <pad_len/>
        <init_cap>yes</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>

  <transform>
    <name>Renombrar campos</name>
    <type>SelectValues</type>
    <description>T1: renombrado de columnas (titulo3-&gt;departamento, nv1-&gt;tipo_entidad, nv2-&gt;compania_raw, valor-&gt;valor_usd)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>titulo3</name>
        <rename>departamento</rename>
      </field>
      <field>
        <name>nv1</name>
        <rename>tipo_entidad</rename>
      </field>
      <field>
        <name>nv2</name>
        <rename>compania_raw</rename>
      </field>
      <field>
        <name>valor</name>
        <rename>valor_usd</rename>
      </field>
      <select_unspecified>Y</select_unspecified>
    </fields>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>

  <transform>
    <name>Catalogo de compania (T9)</name>
    <type>DBLookup</type>
    <description>T9: reemplaza el codigo crudo de compania por el codigo limpio y agrega tipo_compania (mismo catalogo que cat_compania_aps_158.csv en dbt/SQLMesh)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache_size>0</cache_size>
    <cache>N</cache>
    <connection>aps_db</connection>
    <cache_load_all>N</cache_load_all>
    <lookup>
      <eat_row_on_failure>N</eat_row_on_failure>
      <fail_on_multiple>N</fail_on_multiple>
      <key>
        <condition>=</condition>
        <name>compania_raw</name>
        <field>raw_code</field>
      </key>
      <value>
        <type>String</type>
        <rename>compania</rename>
        <name>clean_code</name>
        <trim_type>none</trim_type>
      </value>
      <value>
        <type>String</type>
        <rename>tipo_compania</rename>
        <name>tipo_compania</name>
        <trim_type>none</trim_type>
      </value>
      <table>cat_compania_aps_158</table>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>736</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>

  <transform>
    <name>Salida hop1_resultado_158_subset</name>
    <type>TableOutput</type>
    <description>Resultado final de la prueba HOP-1</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>aps_db</connection>
    <fields>
</fields>
    <ignore_errors>N</ignore_errors>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <specify_fields>N</specify_fields>
    <table>hop1_resultado_158_subset</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>Y</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>864</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>

  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
<!--
  DDL de la tabla destino (crearla antes de correr el pipeline; TableOutput
  no la crea sola con specify_fields=N). También se puede generar desde la
  GUI con el botón "SQL" del transform "Salida hop1_resultado_158_subset".

  CREATE TABLE hop1_resultado_158_subset (
    titulo1 TEXT,
    departamento TEXT,
    modalidad TEXT,
    ramo TEXT,
    tipo_entidad TEXT,
    compania_raw TEXT,
    fecha DATE,
    valor_usd NUMERIC,
    tipo TEXT,
    valor_bs NUMERIC,
    compania TEXT,
    tipo_compania TEXT
  );

  Y la tabla de catálogo (T9), cargada desde seeds/cat_compania_aps_158.csv:

  CREATE TABLE cat_compania_aps_158 (
    raw_code TEXT,
    clean_code TEXT,
    tipo_compania TEXT
  );
-->

